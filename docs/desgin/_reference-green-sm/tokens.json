  },

  "motion": {
    "duration": { "fast": 150, "base": 250, "slow": 400, "carouselAutoAdvance": 4000 },
    "easing": {
      "standard":   "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "origin": "proposed",
    "rules": [
      "Chuyển tab: nền phát sáng của tab đang chọn trượt sang tab mới trong 250ms",
      "Tôn trọng 'Reduce Motion' của hệ điều hành: tắt auto-advance carousel và hiệu ứng trượt/đàn hồi"
    ]
  },

  "zIndex": {
    "base": 0,
    "stickyHeader": 10,
    "floatingSearch": 20,
    "tabBar": 30,
    "bottomCtaBar": 40,
    "modal": 100,
    "toast": 110
  },

  "breakpoints": {
    "origin": "proposed",
    "compact": "<= 360 (iPhone SE, Android nhỏ): lưới dịch vụ vẫn 4 cột nhưng nhãn xuống 2 dòng, icon 40",
    "regular": "361-430: bố cục chuẩn trong ảnh",
    "large": ">= 431 (tablet/gập): giữ chiều rộng nội dung tối đa 480, canh giữa"
