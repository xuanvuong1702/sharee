{
  "$meta": {
    "name": "sharee-design-tokens",
    "version": "1.1.0",
    "source": "Green SM-inspired visual language, adapted for negotiated ride-hailing. No Green SM assets.",
    "unit": "pt (iOS) / dp (Android) / px (web)",
    "rule": "Chỉ dùng token. Cấm hardcode hex/px/ms trong UI."
  },
  "color": {
    "brand": {
      "primaryVivid": { "value": "#2CCBD3", "use": "Active indicator, icon, glow; không dùng chữ trắng nhỏ" },
      "primary": { "value": "#5EC9D1", "use": "Tint, illustration, selected surface" },
      "primaryDeep": { "value": "#0E7F88", "use": "CTA chính, accessible text/link trên nền sáng" },
      "primaryText": { "value": "#1A8F98", "use": "Link/giá trên nền trắng" },
      "primaryTint": { "value": "#E6F7F8", "use": "Nền tonal, card, badge" },
      "primaryBorder": { "value": "#BFE6E9", "use": "Viền tonal" },
      "onPrimary": { "value": "#FFFFFF", "use": "Chỉ trên primaryDeep/primaryVivid ở chữ lớn" }
    },
    "neutral": {
      "ink900": { "value": "#0B1B22", "use": "Heading, nền tối" },
      "ink": { "value": "#1E2528", "use": "Chữ chính" },
      "ink700": { "value": "#3A4244", "use": "Chip selected, chữ phụ đậm" },
      "muted": { "value": "#6B7479", "use": "Metadata" },
      "mutedLight": { "value": "#9AA2A7", "use": "Placeholder/icon disabled" },
      "bg": { "value": "#F4F6F8", "use": "Nền chính" },
      "surface": { "value": "#FFFFFF", "use": "Card/input" },
      "surfaceAlt": { "value": "#FBFDFD", "use": "Card phụ" },
      "line": { "value": "#E3E7EA", "use": "Viền/divider" },
      "disabledBg": { "value": "#F0F1F3" },
      "disabledText": { "value": "#B8BDC2" }
    },
    "semantic": {
      "promoBg": { "value": "#FBEFB0", "use": "Badge ưu đãi" },
      "promoText": { "value": "#8A6A12" },
      "warning": { "value": "#D4A82C", "use": "Chưa xác thực, countdown" },
      "warningSoft": { "value": "#FFF8E1" },
      "success": { "value": "#2E9E6A", "use": "Trust, escrow, hoàn tất" },
      "successSoft": { "value": "#E3F5E8" },
      "safety": { "value": "#C2410C", "use": "SOS/an toàn" },
      "safetySoft": { "value": "#F8E6EA" },
      "danger": { "value": "#D64545", "use": "Huỷ, lỗi, xóa" },
      "dangerSoft": { "value": "#FBE9E9" },
      "info": { "value": "#2F7FD1" },
      "infoSoft": { "value": "#EAF3FF" }
    },
    "overlay": {
      "scrim": { "value": "rgba(30,37,40,0.55)" },
      "glass": { "value": "rgba(255,255,255,0.72)" },
      "glassStroke": { "value": "rgba(255,255,255,0.75)" },
      "mapDim": { "value": "rgba(30,37,40,0.08)" }
    },
    "gradient": {
      "hero": { "value": "linear-gradient(135deg, #D9F3F4 0%, #FFFFFF 52%, #FBF1DC 100%)" },
      "primary": { "value": "linear-gradient(135deg, #5EC9D1 0%, #2CCBD3 100%)" },
      "safe": { "value": "linear-gradient(135deg, #E6F7F8 0%, #FFFFFF 100%)" },
      "promo": { "value": "linear-gradient(135deg, #FFF8E1 0%, #FFFFFF 100%)" },
      "cardDark": { "value": "linear-gradient(135deg, #0B1B22 0%, #0E4F55 100%)" }
    }
  },
  "typography": {
    "family": { "primary": "BeVietnamPro", "fallback": "Inter, system-ui, sans-serif" },
    "scale": {
      "display": { "size": 34, "lineHeight": 38, "weight": 800, "letterSpacing": -1.0 },
      "h1": { "size": 28, "lineHeight": 34, "weight": 800, "letterSpacing": -0.7 },
      "h2": { "size": 22, "lineHeight": 28, "weight": 700, "letterSpacing": -0.4 },
      "title": { "size": 18, "lineHeight": 24, "weight": 700, "letterSpacing": -0.2 },
      "section": { "size": 16, "lineHeight": 22, "weight": 700 },
      "body": { "size": 15, "lineHeight": 22, "weight": 400 },
      "bodyStrong": { "size": 15, "lineHeight": 22, "weight": 600 },
      "small": { "size": 13, "lineHeight": 18, "weight": 400 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 500 },
      "micro": { "size": 11, "lineHeight": 14, "weight": 600 },
      "price": { "size": 24, "lineHeight": 28, "weight": 800, "tnum": true },
      "priceLarge": { "size": 34, "lineHeight": 38, "weight": 800, "tnum": true }
    },
    "rules": [
      "Không dùng chữ < 12pt (trừ micro badge 11pt)",
      "Số tiền/ETA dùng tabular figures",
      "Dynamic Type 130% không vỡ",
      "Tiếng Việt lineHeight >= 1.3"
    ]
  },
  "spacing": {
    "unit": 4,
    "scale": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 24, "xxl": 32, "xxxl": 40 },
    "pageGutter": 16,
    "cardGap": 10,
    "sectionGap": 24,
    "listRowVertical": 14,
    "sheetPadding": 20
  },
  "size": {
    "touchMin": 44,
    "buttonHeight": 52,
    "buttonHeightSm": 40,
    "inputHeight": 52,
    "chipHeight": 36,
    "searchHeight": 52,
    "tabBarHeight": 64,
    "tabBarBottom": 10,
    "tabBarIcon": 24,
    "actionButton": 58,
    "avatar": { "sm": 32, "md": 44, "lg": 72 },
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "serviceIcon": { "sm": 40, "md": 48, "lg": 64, "xl": 96 },
    "heroCardHeight": 100,
    "offerCardMinHeight": 132
  },
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 28,
    "pill": 999,
    "use": {
      "card": "xl",
      "input": "md",
      "button": "md",
      "sheet": "xxl",
      "chip": "pill",
      "search": "pill",
      "avatar": "pill",
      "ticket": "xl",
      "tabBar": "pill"
    }
  },
  "elevation": {
    "none": "none",
    "card": "0 2px 8px rgba(30,37,40,0.06)",
    "chip": "0 1px 4px rgba(30,37,40,0.08)",
    "float": "0 8px 24px rgba(30,37,40,0.12)",
    "sheet": "0 -12px 40px rgba(30,37,40,0.12)",
    "glowActive": "0 0 24px rgba(44,203,211,0.45)",
    "cta": "0 4px 10px rgba(44,203,211,0.35)"
  },
  "blur": { "glass": 20 },
  "motion": {
    "duration": { "fast": 150, "base": 220, "tab": 250, "sheet": 280, "slow": 400, "map": 500, "success": 500, "carousel": 4000 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "rules": [
      "Tôn trọng Reduce Motion",
      "Tab indicator 250ms spring",
      "Không auto-play carousel quá 4s",
      "3D icon float chỉ decorative, tắt khi Reduce Motion"
    ]
  },
  "opacity": {
    "disabled": 0.45,
    "pressed": 0.08,
    "scrim": 0.55,
    "mapDim": 0.08,
    "mutedText": 0.72
  },
  "border": {
    "default": "1px solid #E3E7EA",
    "focus": "2px solid #1A8F98",
    "error": "1.5px solid #D64545",
    "divider": "1px solid #E3E7EA"
  },
  "zIndex": {
    "base": 0,
    "mapOverlay": 10,
    "stickyHeader": 20,
    "sheet": 30,
    "tabBar": 40,
    "bottomCta": 50,
    "modal": 100,
    "toast": 110
  },
  "breakpoints": {
    "compact": "<= 360",
    "regular": "361-430",
    "large": ">= 431",
    "tablet": ">= 768",
    "desktop": ">= 1200"
  },
  "map": {
    "style": "light",
    "routeColor": "#0E7F88",
    "routeWidth": 5,
    "pickup": "#2E9E6A",
    "destination": "#D4A82C",
    "driver": "#0B1B22",
    "dimOpacity": 0.08,
    "clusterRadius": 40
  }
}
