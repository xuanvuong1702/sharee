{
  "$meta": {
    "name": "sharee-design-tokens",
    "version": "1.0.0",
    "source": "Thiết kế mới cho mô hình chợ chuyến đi thương lượng giá. Không dùng token Green SM.",
    "unit": "pt (iOS) / dp (Android) / px (web)",
    "rule": "Chỉ dùng token. Cấm hardcode hex/px/ms trong UI."
  },
  "color": {
    "brand": {
      "ink": { "value": "#071A33", "use": "Heading, nền tối, tab bar, hero" },
      "primary": { "value": "#1F5EFF", "use": "CTA chính, active, link" },
      "primaryDeep": { "value": "#1747CC", "use": "Pressed, gradient CTA" },
      "primarySoft": { "value": "#EBF0FF", "use": "Selected, tint" },
      "primaryBorder": { "value": "#C7D5FF", "use": "Viền tonal" },
      "accent": { "value": "#FFB020", "use": "Giá counter, countdown, cảnh báo nhẹ" },
      "accentSoft": { "value": "#FFF3E0", "use": "Nền offer/counter" },
      "mint": { "value": "#00C2A8", "use": "Trust, KYC, escrow, success" },
      "mintSoft": { "value": "#E6F8F0", "use": "Nền trust/success" },
      "onPrimary": { "value": "#FFFFFF" }
    },
    "neutral": {
      "ink": { "value": "#071A33" },
      "ink700": { "value": "#334155" },
      "muted": { "value": "#64748B" },
      "mutedLight": { "value": "#94A3B8" },
      "bg": { "value": "#F6F8FB" },
      "surface": { "value": "#FFFFFF" },
      "surfaceAlt": { "value": "#FBFCFE" },
      "line": { "value": "#E4EAF3" },
      "disabledBg": { "value": "#F1F4F9" },
      "disabledText": { "value": "#B8C0CC" }
    },
    "semantic": {
      "success": { "value": "#0FA968" },
      "successSoft": { "value": "#E6F8F0" },
      "warning": { "value": "#B45309" },
      "warningSoft": { "value": "#FFF3E0" },
      "danger": { "value": "#E5484D" },
      "dangerSoft": { "value": "#FDECEC" },
      "info": { "value": "#2F7FD1" },
      "infoSoft": { "value": "#EAF3FF" },
      "safety": { "value": "#C2410C" },
      "safetySoft": { "value": "#FFF0E8" }
    },
    "overlay": {
      "scrim": { "value": "rgba(7,26,51,0.55)" },
      "mapDim": { "value": "rgba(7,26,51,0.08)" },
      "glass": { "value": "rgba(255,255,255,0.82)" },
      "glassStroke": { "value": "rgba(255,255,255,0.65)" }
    },
    "gradient": {
      "brand": { "value": "linear-gradient(135deg, #071A33 0%, #133B8F 58%, #1F5EFF 100%)" },
      "trust": { "value": "linear-gradient(135deg, #071A33 0%, #0B5F55 100%)" },
      "receipt": { "value": "linear-gradient(180deg, #FFFFFF 0%, #FBFCFE 100%)" }
    }
  },
  "typography": {
    "family": {
      "primary": "BeVietnamPro",
      "fallback": "Inter, system-ui, sans-serif"
    },
    "scale": {
      "display": { "size": 34, "lineHeight": 38, "weight": 800, "letterSpacing": -1.0 },
      "h1": { "size": 28, "lineHeight": 34, "weight": 800, "letterSpacing": -0.7 },
      "h2": { "size": 22, "lineHeight": 28, "weight": 800, "letterSpacing": -0.4 },
      "title": { "size": 18, "lineHeight": 24, "weight": 700, "letterSpacing": -0.2 },
      "section": { "size": 16, "lineHeight": 22, "weight": 700 },
      "body": { "size": 15, "lineHeight": 22, "weight": 400 },
      "bodyStrong": { "size": 15, "lineHeight": 22, "weight": 600 },
      "small": { "size": 13, "lineHeight": 18, "weight": 400 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 500 },
      "micro": { "size": 11, "lineHeight": 14, "weight": 600 },
      "price": { "size": 24, "lineHeight": 28, "weight": 800, "tnum": true },
      "priceLarge": { "size": 34, "lineHeight": 38, "weight": 800, "tnum": true }
    },
    "rules": [
      "Không dùng chữ < 12pt (trừ micro badge 11pt)",
      "Số tiền/ETA dùng tabular figures",
      "Dynamic Type 130% không vỡ",
      "Tiếng Việt lineHeight >= 1.3"
    ]
  },
  "spacing": {
    "unit": 4,
    "scale": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 24, "xxl": 32, "xxxl": 40 },
    "pageGutter": 16,
    "cardGap": 12,
    "sectionGap": 24,
    "listRowVertical": 14,
    "sheetPadding": 20
  },
  "size": {
    "touchMin": 44,
    "buttonHeight": 52,
    "buttonHeightSm": 40,
    "inputHeight": 52,
    "chipHeight": 36,
    "searchHeight": 52,
    "tabBarHeight": 64,
    "tabBarBottom": 8,
    "avatar": { "sm": 32, "md": 44, "lg": 64 },
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "vehicleImage": { "width": 96, "height": 64 },
    "mapMarker": 40,
    "safetyButton": 44,
    "bottomSheetHandle": 4,
    "offerCardMinHeight": 132
  },
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 28,
    "pill": 999,
    "use": {
      "card": "xl",
      "input": "md",
      "button": "md",
      "sheet": "xxl",
      "chip": "pill",
      "search": "pill",
      "avatar": "pill",
      "ticket": "xl"
    }
  },
  "elevation": {
    "none": "none",
    "card": "0 8px 24px rgba(7,26,51,0.06)",
    "float": "0 18px 50px rgba(7,26,51,0.16)",
    "sheet": "0 -12px 40px rgba(7,26,51,0.12)",
    "cta": "0 12px 30px rgba(31,94,255,0.24)"
  },
  "motion": {
    "duration": { "fast": 150, "base": 220, "sheet": 280, "slow": 400, "success": 500 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "rules": [
      "Tôn trọng Reduce Motion",
      "Map camera 500ms",
      "Offer mới fade/slide 220ms",
      "Không auto-play carousel"
    ]
  },
  "opacity": {
    "disabled": 0.45,
    "pressed": 0.08,
    "scrim": 0.55,
    "mapDim": 0.08,
    "mutedText": 0.72
  },
  "border": {
    "default": "1px solid #E4EAF3",
    "focus": "2px solid #1F5EFF",
    "error": "1.5px solid #E5484D",
    "divider": "1px solid #E4EAF3"
  },
  "zIndex": {
    "base": 0,
    "mapOverlay": 10,
    "stickyHeader": 20,
    "sheet": 30,
    "tabBar": 40,
    "bottomCta": 50,
    "modal": 100,
    "toast": 110
  },
  "breakpoints": {
    "compact": "<= 360",
    "regular": "361-430",
    "large": ">= 431",
    "tablet": ">= 768",
    "desktop": ">= 1200"
  },
  "map": {
    "style": "light",
    "routeColor": "#1F5EFF",
    "routeWidth": 5,
    "pickup": "#00C2A8",
    "destination": "#FFB020",
    "driver": "#071A33",
    "dimOpacity": 0.08,
    "clusterRadius": 40
  }
}
