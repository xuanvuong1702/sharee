# Copy to .env and set strong, unique values. Never commit .env.
POSTGRES_DB=sharee
POSTGRES_USER=sharee
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-long-random-password

# openssl rand -base64 48
JWT_KEY=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-at-least-16-random-characters

# Field encryption: >=32 random bytes, base64 recommended.
# openssl rand -base64 48
SECURITY_DATA_KEY=replace-with-at-least-32-random-bytes-base64
# Optional previous key while re-encrypting legacy enc:v1 rows.
SECURITY_DATA_KEY_LEGACY=

# Twilio SMS (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+84...

# PayOS payment gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://app.example.com/payment/return
PAYOS_CANCEL_URL=https://app.example.com/payment/cancel

# Firebase Cloud Messaging service account JSON (host path)
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# APNs direct push is optional when FCM is configured for iOS.
APNS_ENABLED=false

# Public HTTPS origins (no trailing slash)
APP_ORIGIN=https://app.example.com
ADMIN_ORIGIN=https://admin.example.com
WEB_ORIGIN=https://www.example.com
API_PUBLIC_URL=https://api.example.com

# One-time admin bootstrap; remove/unset after creating the first admin.
BOOTSTRAP_TOKEN=

# Private driver verification documents (Docker volume mount)
Storage__VerificationRoot=/data/verifications
Storage__AppealRoot=/data/appeals
